# =============================================================================
# ANGKON — Luxury Fashion & Royal Apparel
# Environment Configuration Template (.env.example)
#
# MANUAL CONTROL ARCHITECTURE (Modeled on ShaplaTrade & PH-Health-care):
# 1. DATABASE: Manual selection via DATABASE_URL ('angkon_dev' or 'angkon').
# 2. PAYMENT:  Independent manual control via SSLCOMMERZ_MODE (sandbox / live).
# 3. COURIER:  Independent manual control via COURIER_MODE (mock / live).
#
# Changing DATABASE_URL will NEVER automatically switch payment or courier modes!
#
# IMPORTANT:
# - Copy this file to `.env` for local development.
# - NEVER commit `.env` or real production credentials to Git.
# =============================================================================

# =============================================================================
# 1. APPLICATION ENVIRONMENT & DATABASE SELECTION (MANUAL)
# =============================================================================
# Declared environment: "development" | "production" | "preview" | "test"
APP_ENVIRONMENT=development
NODE_ENV=development
PORT=3000

# Canonical Site URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authoritative Application Database Connection
# Supported databases: "angkon_dev" (development/staging) or "angkon" (production).
# The application will NEVER silently rewrite, substitute, or switch this database.
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/angkon_dev?retryWrites=true&w=majority

# Direct Replica-Set connection (recommended if SRV DNS times out):
# DATABASE_URL=mongodb://username:password@shard-00-00.mongodb.net:27017,shard-00-01.mongodb.net:27017,shard-00-02.mongodb.net:27017/angkon_dev?ssl=true&replicaSet=atlas-xxx-shard-0&authSource=admin&retryWrites=true&w=majority

# Safety Lock: Connecting to production database "angkon" from non-production
# is strictly rejected by default. Set to "true" ONLY for intentional maintenance.
ALLOW_PRODUCTION_DB_ACCESS=false

# Optional: DNS servers for mongodb+srv SRV lookups (e.g. 8.8.8.8,1.1.1.1)
MONGODB_DNS_SERVERS=

# MongoDB Connection Pool & Timeout Settings
MONGODB_MAX_POOL_SIZE=5
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_CONNECTING=2
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000

# =============================================================================
# 2. SSLCOMMERZ PAYMENT GATEWAY CONFIGURATION (INDEPENDENT)
# =============================================================================
# Mode: "sandbox" (test accounts) | "live" (real payments)
# Changing the database NEVER changes the payment mode!
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_IS_LIVE=false

# Scoped credentials (live and sandbox must never share credentials)
SSLCOMMERZ_SANDBOX_STORE_ID=
SSLCOMMERZ_SANDBOX_STORE_PASSWORD=
SSLCOMMERZ_LIVE_STORE_ID=
SSLCOMMERZ_LIVE_STORE_PASSWORD=

# Legacy credentials fallback (used if scoped variables are unset)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Gateway HTTP timeout in milliseconds
SSLCOMMERZ_TIMEOUT_MS=15000
# Pending payment session TTL in minutes
PAYMENT_SESSION_TTL_MINUTES=240

# =============================================================================
# 3. COURIER & LOGISTICS CONFIGURATION (INDEPENDENT)
# =============================================================================
# Operating mode: "mock" (simulated bookings, zero HTTP calls) | "live" (real shipments)
# Default for development is strictly "mock".
COURIER_MODE=mock

# Extra production safety lock: Must be "true" to create real Steadfast consignments
STEADFAST_LIVE_BOOKING_ENABLED=false

# Non-production live test bypass (requires STEADFAST_LIVE_BOOKING_ENABLED=true)
FORCE_LIVE_COURIER_TEST=false

# Steadfast Courier Credentials (SERVER-ONLY)
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_WEBHOOK_TOKEN=
STEADFAST_WEBHOOK_SECRET=

# Secondary Courier Providers (Optional)
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_CITY_ID=
PATHAO_ZONE_ID=
PATHAO_ITEM_WEIGHT=0.5
PATHAO_WEBHOOK_SECRET=

REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta
REDX_API_TOKEN=
REDX_AREA_ID=
REDX_AREA_NAME=
REDX_PICKUP_STORE_ID=
REDX_WEBHOOK_SECRET=

ECOURIER_BASE_URL=https://backoffice.ecourier.com.bd/api
ECOURIER_API_KEY=
ECOURIER_API_SECRET=
ECOURIER_USER_ID=
ECOURIER_PACKAGE_CODE=
ECOURIER_WEBHOOK_SECRET=

# =============================================================================
# 4. CLOUDINARY MEDIA CDN (SINGLE ROOT: ANGKON/)
# =============================================================================
# Shared unified asset catalog root: ANGKON/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_CLOUDINARY_DELIVERY_DOMAIN=
META_CATALOG_IMAGE_DOMAIN=
# Safety lock against accidental asset deletions in non-production
ALLOW_PROD_CLOUDINARY_MUTATIONS=false

# =============================================================================
# 5. SECURITY, ADMIN AUTHENTICATION & REVERSE PROXY
# =============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_here
JWT_SECRET=your_random_64_char_jwt_secret_here
CRON_SECRET=your_unique_cron_secret_here
DISABLE_IN_PROCESS_WORKERS=false
META_TOKEN_ENCRYPTION_KEY=
ENCRYPTION_KEY=
RATE_LIMIT_HMAC_SECRET=
TRUST_PROXY_HEADERS=true
TRUST_CLOUDFLARE_IP_HEADER=false
CSRF_TRUSTED_ORIGINS=

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_signing_secret
EMAIL_FROM=ANGKON Orders <orders@angkon.net>
EMAIL_REPLY_TO=contact@angkon.com.bd
EMAIL_SITE_URL=https://angkon.net
ADMIN_EMAIL=angkonofficial08@gmail.com
# Safety default: false ensures development never emails real customers
ENABLE_REAL_EMAIL=false
SAFE_TEST_EMAIL=

# Meta Marketing & Direct CAPI
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_SECRET=
META_CATALOG_FEED_KEY=
META_GRAPH_API_VERSION=v22.0
META_EVENT_LOG_TTL_SECONDS=7776000
NEXT_PUBLIC_ENABLE_META_ROUTES=false
ENABLE_META_SUITE=true
ENABLE_PRODUCTION_META_EVENTS=false

PRIMARY_TENANT_ID=angkon-main
