# ANGKON — House of Modern Heritage
# Environment Configuration Template

# WooCommerce REST API (Live store credentials)
NEXT_PUBLIC_WC_API_URL=https://your-wordpress-site.com
NEXT_PUBLIC_WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-Only Write Keys (for order creation & inventory updates)
WC_ORDERS_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_ORDERS_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin Dashboard Authentication
ADMIN_JWT_SECRET=your_secure_jwt_secret_here

# Database Configuration (Optional direct PostgreSQL connection)
DATABASE_URL=postgresql://user:password@localhost:5432/angkon_db
