# =============================================================================
# ANGKON — Luxury Fashion & Royal Apparel
# Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - Copy this file to `.env` (or configure in your production hosting env settings).
# - NEVER commit `.env` or real API keys/passwords to git.
# =============================================================================

# --- Application Environment & Isolation Engine ---
# Mandatory: "production" | "preview" | "development" | "test"
# Enforces strict database mapping:
#   production  -> angkon
#   development -> angkon_dev
#   preview     -> angkon_preview
#   test        -> angkon_test
APP_ENVIRONMENT=development

# --- Site Canonical URL ---
NEXT_PUBLIC_SITE_URL=https://angkon.net
NEXT_PUBLIC_BASE_URL=https://angkon.net
SITE_URL=https://angkon.net
NEXT_PUBLIC_APP_URL=https://angkon.net

# --- Database (MongoDB Atlas) ---
# Any of these 3 variable names work: MONGODB_URI, MONGODB_URL, or DATABASE_URL
# The database in the path MUST match APP_ENVIRONMENT:
# e.g. for development: .../angkon_dev?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/angkon_dev?retryWrites=true&w=majority
# Direct Replica-Set connection (bypasses SRV/TXT lookups if DNS times out):
# DATABASE_URL=mongodb://username:password@shard-00-00.mongodb.net:27017,shard-00-01.mongodb.net:27017,shard-00-02.mongodb.net:27017/angkon_dev?ssl=true&replicaSet=atlas-xxx-shard-0&authSource=admin&retryWrites=true&w=majority
# Dedicated Atlas credential verification requires one exact variable per
# environment. The verifier never falls back to DATABASE_URL or aliases.
ANGKON_DEV_DATABASE_URL=
ANGKON_PREVIEW_DATABASE_URL=
ANGKON_TEST_DATABASE_URL=
ANGKON_PROD_DATABASE_URL=
# Optional: DNS servers for mongodb+srv SRV lookups when the OS resolver
# refuses them (e.g. some ISP resolvers return EREFUSED). Example:
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
MONGODB_DNS_SERVERS=
# Optional pool/timeout tuning. Defaults are safe for small VPS instances.
MONGODB_MAX_POOL_SIZE=5
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_CONNECTING=2
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000

# --- Executive Admin Dashboard Security ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_here
JWT_SECRET=your_random_64_char_jwt_secret_here
# Required for Vercel Cron (sent as `Authorization: Bearer <CRON_SECRET>`).
CRON_SECRET=
# Set to "true" for multi-replica deployments (Coolify, Kubernetes, ECS) to disable
# in-process worker loops and rely on external Coolify Cron / scheduled HTTP calls.
DISABLE_IN_PROCESS_WORKERS=false
# Dedicated key for Meta token encryption (recommended; falls back to JWT_SECRET).
META_TOKEN_ENCRYPTION_KEY=
ENCRYPTION_KEY=

# --- Cloudinary (Media & Image CDN) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Optional custom branded delivery domain (e.g. img.angkon.net)
NEXT_PUBLIC_CLOUDINARY_DELIVERY_DOMAIN=
# Optional verified image hostname for Meta Commerce Catalog feed
META_CATALOG_IMAGE_DOMAIN=

# --- Email Notifications (Resend) ---
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=ANGKON Orders <orders@angkon.net>
# Must be an inbox monitored by customer support; replies go here.
EMAIL_REPLY_TO=contact@angkon.com.bd
# Email verification/reset URLs use the verified sender domain, not the request Host.
EMAIL_SITE_URL=https://angkon.net
ADMIN_EMAIL=angkonofficial08@gmail.com
# Default is false so local development never emails real customers.
# Set to true ONLY for an intentional email test.
ENABLE_REAL_EMAIL=false
# Optional: when real email is disabled, send test messages here instead.
SAFE_TEST_EMAIL=

# --- Analytics & Tracking ---
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=your_facebook_pixel_id_here
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_SECRET=
META_CATALOG_FEED_KEY=
META_GRAPH_API_VERSION=v22.0
META_EVENT_LOG_TTL_SECONDS=7776000
META_TOKEN_ROTATION_KEYS=
# Feature switches. Leave defaults unless intentionally enabling public Meta routes.
NEXT_PUBLIC_ENABLE_META_ROUTES=false
NEXT_PUBLIC_DISABLE_META_ROUTES=false
ENABLE_META_SUITE=true
DISABLE_META_SUITE=false

# --- SSLCOMMERZ Payment Gateway (SERVER-ONLY — never NEXT_PUBLIC_) ---
# Sandbox and live must use different stores. The scoped pair wins when set;
# the legacy SSLCOMMERZ_STORE_ID/PASSWORD pair is only a fallback.
SSLCOMMERZ_SANDBOX_STORE_ID=
SSLCOMMERZ_SANDBOX_STORE_PASSWORD=
SSLCOMMERZ_LIVE_STORE_ID=
SSLCOMMERZ_LIVE_STORE_PASSWORD=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_IS_LIVE=false
# Gateway HTTP timeout in milliseconds (session, validation and query calls).
SSLCOMMERZ_TIMEOUT_MS=15000
# Pending gateway sessions older than this are flagged as expired by reconciliation.
# Must comfortably exceed the SSLCOMMERZ hosted-checkout window (the docs' 4-hour default).
PAYMENT_SESSION_TTL_MINUTES=240

# --- Rate limiting / request security (MongoDB-backed, no Redis) ---
# Dedicated HMAC key for hashing client IPs in rate-limit buckets.
# Falls back to JWT_SECRET when empty. Rotating it resets all IP buckets.
RATE_LIMIT_HMAC_SECRET=
# Set false only if the app is reachable directly (no reverse proxy), so
# X-Forwarded-For / X-Real-IP cannot be spoofed.
TRUST_PROXY_HEADERS=true
# Only enable when Cloudflare is definitively in front of the app.
TRUST_CLOUDFLARE_IP_HEADER=false
# Extra origins allowed to make mutating browser requests (comma separated).
# The request Host is always allowed; add www/apex or preview domains here.
CSRF_TRUSTED_ORIGINS=

# --- Steadfast Courier (SERVER-ONLY — never NEXT_PUBLIC_) ---
# Operating mode: "mock" (default for development/testing) or "live" (production).
COURIER_MODE=mock
# Extra production safety lock: Must be explicitly "true" to create real Steadfast consignments.
STEADFAST_LIVE_BOOKING_ENABLED=false
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_WEBHOOK_TOKEN=
STEADFAST_WEBHOOK_SECRET=

# --- Pathao Courier (SERVER-ONLY) ---
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_CITY_ID=
PATHAO_ZONE_ID=
PATHAO_ITEM_WEIGHT=0.5
PATHAO_WEBHOOK_SECRET=

# --- RedX Courier (SERVER-ONLY) ---
REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta
REDX_API_TOKEN=
REDX_AREA_ID=
REDX_AREA_NAME=
REDX_PICKUP_STORE_ID=
REDX_WEBHOOK_SECRET=

# --- eCourier (SERVER-ONLY) ---
ECOURIER_BASE_URL=https://backoffice.ecourier.com.bd/api
ECOURIER_API_KEY=
ECOURIER_API_SECRET=
ECOURIER_USER_ID=
ECOURIER_PACKAGE_CODE=
ECOURIER_WEBHOOK_SECRET=

# --- Tenant / production safety switches ---
PRIMARY_TENANT_ID=angkon-main
TENANT_ID=
# Never enable these in normal development.
ALLOW_PROD_CLOUDINARY_MUTATIONS=false
ENABLE_PRODUCTION_META_EVENTS=false
FORCE_LIVE_COURIER_TEST=false


