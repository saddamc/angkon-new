# =============================================================================
# ANGKON — Luxury Fashion & Royal Apparel
# Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - Copy this file to `.env` (or configure in your production hosting env settings).
# - NEVER commit `.env` or real API keys/passwords to git.
# =============================================================================

# --- Site Canonical URL ---
NEXT_PUBLIC_SITE_URL=https://angkon.com.bd

# --- Database (MongoDB Atlas) ---
# Any of these 3 variable names work: MONGODB_URI, MONGODB_URL, or DATABASE_URL
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/angkon?retryWrites=true&w=majority

# --- Executive Admin Dashboard Security ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_here
JWT_SECRET=your_random_64_char_jwt_secret_here

# --- Cloudinary (Media & Image CDN) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Email Notifications (Resend) ---
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=ANGKON <noreply@angkon.net>
ADMIN_EMAIL=angkonofficial08@gmail.com

# --- Analytics & Tracking ---
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=your_facebook_pixel_id_here
