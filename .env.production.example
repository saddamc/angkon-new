# =============================================================================
# ANGKON VPS PRODUCTION ENVIRONMENT TEMPLATE
# =============================================================================
# Copy this template to /var/www/angkon/shared/.env on the VPS.
# Do NOT rename it to .env.production inside the repository.
# Do NOT commit the completed file. It contains production credentials.
#
# Required production invariants:
# APP_ENVIRONMENT=production
# NODE_ENV=production
# SSLCOMMERZ_MODE=live
# SSLCOMMERZ_IS_LIVE=true
# COURIER_MODE=live
# STEADFAST_LIVE_BOOKING_ENABLED=true
# =============================================================================

# --- Runtime / canonical URLs ---
APP_ENVIRONMENT=production
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://angkon.net
NEXT_PUBLIC_BASE_URL=https://angkon.net
NEXT_PUBLIC_APP_URL=https://angkon.net
SITE_URL=https://angkon.net
NEXTAUTH_URL=https://angkon.net
PRIMARY_TENANT_ID=angkon-main
TENANT_ID=

# --- MongoDB Atlas ---
# Use the production database name `angkon`.
# A direct mongodb:// replica-set URI is recommended on VPS if SRV/TXT DNS is unreliable.
DATABASE_URL=mongodb://<user>:<password>@<host1>:27017,<host2>:27017,<host3>:27017/angkon?replicaSet=<replica-set>&tls=true&authSource=admin
ANGKON_PROD_DATABASE_URL=<same-production-uri-as-DATABASE_URL>
# Keep blank unless the VPS requires an explicit DNS override.
MONGODB_DNS_SERVERS=
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_CONNECTING=2
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000

# --- Authentication / encryption ---
ADMIN_USERNAME=<initial-admin-username>
ADMIN_PASSWORD=<strong-initial-admin-password>
JWT_SECRET=<unique-random-secret-at-least-64-characters>
CRON_SECRET=<unique-random-cron-secret>
META_TOKEN_ENCRYPTION_KEY=<unique-random-encryption-key>
ENCRYPTION_KEY=<unique-random-encryption-key>
RATE_LIMIT_HMAC_SECRET=<unique-random-rate-limit-secret>

# --- Reverse proxy / CSRF ---
TRUST_PROXY_HEADERS=true
# Set true only when Cloudflare is definitely proxying the VPS.
TRUST_CLOUDFLARE_IP_HEADER=false
CSRF_TRUSTED_ORIGINS=https://angkon.net,https://www.angkon.net

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=<production-cloud-name>
CLOUDINARY_API_KEY=<production-api-key>
CLOUDINARY_API_SECRET=<production-api-secret>

# --- Resend email ---
RESEND_API_KEY=<production-resend-api-key>
EMAIL_FROM=ANGKON Orders <orders@angkon.net>
EMAIL_REPLY_TO=contact@angkon.com.bd
EMAIL_SITE_URL=https://angkon.net
ADMIN_EMAIL=<monitored-admin-email>
ENABLE_REAL_EMAIL=true
SAFE_TEST_EMAIL=

# --- Facebook / Meta ---
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=<production-pixel-id>
NEXT_PUBLIC_META_PIXEL_ID=<same-production-pixel-id>
META_PIXEL_ID=<same-production-pixel-id>
META_CAPI_ACCESS_TOKEN=<production-capi-token>
META_AD_ACCOUNT_ID=<production-ad-account-id>
META_APP_SECRET=<production-meta-app-secret>
META_CATALOG_FEED_KEY=<random-feed-key>
META_GRAPH_API_VERSION=v22.0
META_EVENT_LOG_TTL_SECONDS=7776000
META_TOKEN_ROTATION_KEYS=
NEXT_PUBLIC_ENABLE_META_ROUTES=false
NEXT_PUBLIC_DISABLE_META_ROUTES=false
ENABLE_META_SUITE=true
DISABLE_META_SUITE=false

# --- SSLCOMMERZ live payments ---
# Never use sandbox credentials with these live flags.
SSLCOMMERZ_MODE=live
SSLCOMMERZ_IS_LIVE=true
SSLCOMMERZ_LIVE_STORE_ID=<live-store-id>
SSLCOMMERZ_LIVE_STORE_PASSWORD=<live-store-password>
# Legacy fallback may remain blank when scoped live credentials are present.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX_STORE_ID=
SSLCOMMERZ_SANDBOX_STORE_PASSWORD=
SSLCOMMERZ_TIMEOUT_MS=15000
PAYMENT_SESSION_TTL_MINUTES=240

# --- Steadfast live courier ---
# The VPS public IP must be allowlisted by Steadfast.
COURIER_MODE=live
STEADFAST_LIVE_BOOKING_ENABLED=true
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=<live-api-key>
STEADFAST_SECRET_KEY=<live-secret-key>
STEADFAST_WEBHOOK_TOKEN=
STEADFAST_WEBHOOK_SECRET=<live-webhook-secret>

# --- Optional courier integrations ---
# Leave blank until separately authorized and tested.
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_CITY_ID=
PATHAO_ZONE_ID=
PATHAO_ITEM_WEIGHT=0.5
PATHAO_WEBHOOK_SECRET=
REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta
REDX_API_TOKEN=
REDX_AREA_ID=
REDX_AREA_NAME=
REDX_PICKUP_STORE_ID=
REDX_WEBHOOK_SECRET=
ECOURIER_BASE_URL=https://backoffice.ecourier.com.bd/api
ECOURIER_API_KEY=
ECOURIER_API_SECRET=
ECOURIER_USER_ID=
ECOURIER_PACKAGE_CODE=
ECOURIER_WEBHOOK_SECRET=

# --- Production feature safety ---
# Do not set these production-bypass flags on the VPS.
ALLOW_PROD_CLOUDINARY_MUTATIONS=
ENABLE_PRODUCTION_META_EVENTS=
FORCE_LIVE_COURIER_TEST=
