# =============================================================================
# ANGKON — PRODUCTION ENVIRONMENT CONFIGURATION (.env.production.example)
#
# MANUAL CONTROL ARCHITECTURE:
# - APP_ENVIRONMENT: strictly "production"
# - DATABASE_URL: strictly points to "angkon"
# - SSLCOMMERZ_MODE: "live" with dedicated live credentials (no "testbox" prefix)
# - COURIER_MODE: "live" with STEADFAST_LIVE_BOOKING_ENABLED=true
# - CLOUDINARY: shared root ANGKON/
#
# Note: Rebuild & redeploy container after changing any NEXT_PUBLIC_* variable.
# =============================================================================

# =============================================================================
# 1. APPLICATION ENVIRONMENT & DATABASE SELECTION
# =============================================================================
APP_ENVIRONMENT=production
NODE_ENV=production
PORT=3000

# Canonical Production URLs
NEXT_PUBLIC_SITE_URL=https://angkon.net
NEXT_PUBLIC_BASE_URL=https://angkon.net
NEXT_PUBLIC_APP_URL=https://angkon.net
SITE_URL=https://angkon.net
NEXTAUTH_URL=https://angkon.net
PRIMARY_TENANT_ID=angkon-main

# Authoritative Production MongoDB Connection (Replica Set Recommended)
DATABASE_URL=mongodb://<user>:<password>@<host1>:27017,<host2>:27017,<host3>:27017/angkon?replicaSet=<replica-set>&tls=true&authSource=admin

# Production Connection Pool Tuning
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_CONNECTING=2
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000

# =============================================================================
# 2. SSLCOMMERZ LIVE PAYMENT CONFIGURATION
# =============================================================================
SSLCOMMERZ_MODE=live
SSLCOMMERZ_IS_LIVE=true
SSLCOMMERZ_LIVE_STORE_ID=<live-store-id>
SSLCOMMERZ_LIVE_STORE_PASSWORD=<live-store-password>
SSLCOMMERZ_TIMEOUT_MS=15000
PAYMENT_SESSION_TTL_MINUTES=240

# =============================================================================
# 3. STEADFAST LIVE COURIER CONFIGURATION
# =============================================================================
COURIER_MODE=live
STEADFAST_LIVE_BOOKING_ENABLED=true
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=<live-api-key>
STEADFAST_SECRET_KEY=<live-secret-key>
STEADFAST_WEBHOOK_SECRET=<live-webhook-secret>

# =============================================================================
# 4. CLOUDINARY MEDIA CDN (SINGLE ROOT: ANGKON/)
# =============================================================================
CLOUDINARY_CLOUD_NAME=drtzgyetn
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=drtzgyetn
CLOUDINARY_API_KEY=<production-api-key>
CLOUDINARY_API_SECRET=<production-api-secret>

# =============================================================================
# 5. SECURITY, ADMIN & REVERSE PROXY CONFIGURATION
# =============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<production-admin-password>
JWT_SECRET=<unique-64+-char-secret>
CRON_SECRET=<unique-cron-secret>
META_TOKEN_ENCRYPTION_KEY=<unique-encryption-key>
ENCRYPTION_KEY=<unique-encryption-key>
RATE_LIMIT_HMAC_SECRET=<unique-rate-limit-secret>
TRUST_PROXY_HEADERS=true
TRUST_CLOUDFLARE_IP_HEADER=false
CSRF_TRUSTED_ORIGINS=https://angkon.net,https://www.angkon.net

# Production Resend Email
RESEND_API_KEY=<production-resend-api-key>
EMAIL_FROM=ANGKON Orders <orders@angkon.net>
ADMIN_EMAIL=<monitored-admin-email>
ENABLE_REAL_EMAIL=true
EMAIL_REPLY_TO=contact@angkon.com.bd
EMAIL_SITE_URL=https://angkon.net

# Meta Direct Credentials & Catalog
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=<production-pixel-id>
META_CAPI_ACCESS_TOKEN=<production-capi-token>
META_AD_ACCOUNT_ID=<production-ad-account-id>
META_CATALOG_FEED_KEY=<random-feed-key>
